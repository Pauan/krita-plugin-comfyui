  "global_widgets": [
    {
      "type": "group",
      "id": "model_group",
      "label": "Defaults",
      "default": true,
      "children": [
        {
          "type": "row",
          "children": [
            {
              "type": "combo",
              "id": "sampler_name",
              "link_to": {
                "node_id": "KSampler",
                "input": "sampler_name"
