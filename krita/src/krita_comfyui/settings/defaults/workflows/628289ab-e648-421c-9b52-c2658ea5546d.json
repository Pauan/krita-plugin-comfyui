              "default": "euler"
            },
            {
              "type": "combo",
              "id": "scheduler",
              "link_to": {
                "node_id": "KSampler",
                "input": "scheduler"
              },
              "stretch": 1,
              "default": "simple"
            }
          ]
        },
        {
          "type": "int",
          "id": "steps",
          "link_to": {
            "node_id": "KSampler",
            "input": "steps"
          },
          "default": 20,
          "suffix": " steps"
        },
        {
          "type": "float",
          "id": "cfg",
          "link_to": {
            "node_id": "KSampler",
            "input": "cfg"
          },
          "suffix": " prompt weight",
          "default": 3.5
        },
        {
          "type": "prompt",
          "id": "default_prompt",
          "tooltip": "Default prompt",
          "placeholder": "Default prompt...",
          "default": "色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走 * -1.0"
        }
      ]
    },

    {
      "type": "group",
      "id": "turbo_group",
      "label": "Defaults (Turbo)",
      "children": [
        {
          "type": "boolean",
          "id": "turbo_enabled",
          "label": "Turbo enabled"
        },
        {
          "type": "int",
          "id": "turbo_steps",
          "link_to": {
            "node_id": "KSampler",
            "input": "steps"
          },
          "default": 4,
          "suffix": " steps"
        },
        {
          "type": "float",
          "id": "turbo_cfg",
          "link_to": {
            "node_id": "KSampler",
            "input": "cfg"
          },
          "suffix": " prompt weight",
          "default": 1.0
        }
      ]
    }
  ],

