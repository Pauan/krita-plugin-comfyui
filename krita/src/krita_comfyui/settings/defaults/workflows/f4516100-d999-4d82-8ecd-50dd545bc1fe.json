{
  "version": 1,
  "name": "Anima",
  "id": "f4516100-d999-4d82-8ecd-50dd545bc1fe",
  "icon": "config-canvas-only",
  "is_default": true,

  "layout": [
    {
      "type": "percentage",
      "id": "image_strength",
      "link_to": {
        "node_id": "krita_comfyui: img2img",
        "input": "strength"
      },
      "step": 0.05,
      "prefix": "Image Strength: "
    },
    {
      "type": "prompt",
      "id": "prompt"
    },
    {
      "type": "group",
      "id": "mask_regions_group",
      "label": "Mask Regions",
      "default": false,
      "children": [
        {
          "type": "list",
          "id": "mask_regions_list",
          "label": "region",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "boolean",
                  "id": "mask_regions_enabled",
                  "tooltip": "Whether the mask regions is enabled."
                },
                {
                  "type": "layer_id",
                  "id": "mask_regions_layer",
                  "tooltip": "Mask Regions Layer Group",
                  "stretch": 1,
                  "enabled_if": {
                    "id": "mask_regions_enabled",
                    "value": true
                  }
                }
              ]
            },
            {
              "type": "prompt",
              "id": "mask_regions_prompt",
              "tooltip": "Region prompt",
              "placeholder": "Region prompt...",
              "enabled_if": {
                "id": "mask_regions_enabled",
                "value": true
              }
            }
          ]
        }
      ]
    },
    {
      "type": "group",
      "id": "controlnet_group",
      "label": "Control Nets",
      "default": false,
      "children": [
        {
          "type": "list",
          "id": "controlnet_list",
          "label": "control net",
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "boolean",
                  "id": "controlnet_enabled",
                  "tooltip": "Whether the control net is enabled."
                },
                {
                  "type": "layer_id",
                  "id": "controlnet_layer",
                  "tooltip": "Control Net Layer",
                  "stretch": 1,
                  "enabled_if": {
                    "id": "controlnet_enabled",
                    "value": true
                  }
                }
              ]
            },
            {
              "type": "combo",
              "id": "controlnet_model",
              "link_to": {
                "node_id": "krita_comfyui: MakeControlNet",
                "input": "model"
              },
              "enabled_if": {
                "id": "controlnet_enabled",
                "value": true
              }
            },
            {
              "type": "percentage",
              "id": "controlnet_start",
              "link_to": {
                "node_id": "krita_comfyui: MakeControlNet",
                "input": "start_percent"
              },
              "step": 0.05,
              "prefix": "Start: ",
              "enabled_if": {
                "id": "controlnet_enabled",
                "value": true
              }
            },
            {
              "type": "percentage",
              "id": "controlnet_end",
              "link_to": {
                "node_id": "krita_comfyui: MakeControlNet",
                "input": "end_percent"
              },
              "step": 0.05,
              "prefix": "End: ",
              "enabled_if": {
                "id": "controlnet_enabled",
                "value": true
              }
            },
            {
              "type": "percentage",
              "id": "controlnet_strength",
              "link_to": {
                "node_id": "krita_comfyui: MakeControlNet",
                "input": "strength"
              },
              "step": 0.05,
              "prefix": "Strength: ",
              "enabled_if": {
                "id": "controlnet_enabled",
                "value": true
              }
            },
            {
              "type": "boolean",
              "id": "controlnet_invert",
              "label": "Invert image",
              "tooltip": "Black becomes white, white becomes black.",
              "enabled_if": {
                "id": "controlnet_enabled",
                "value": true
              },
              "default": false
            }
          ]
        }
      ]
    },
    {
      "type": "group",
      "id": "advanced",
      "label": "Advanced",
      "indent": true,
      "default": false,
      "children": [
        {
          "type": "combo",
          "id": "checkpoint",
          "link_to": {
            "node_id": "UNETLoader",
            "input": "unet_name"
          }
        },
        {
          "type": "row",
          "children": [
            {
              "type": "combo",
              "id": "sampler_name",
              "link_to": {
                "node_id": "KSampler",
                "input": "sampler_name"
              },
              "stretch": 1,
              "default": "gradient_estimation"
            },
            {
              "type": "combo",
              "id": "scheduler",
              "link_to": {
                "node_id": "KSampler",
                "input": "scheduler"
              },
              "stretch": 1,
              "default": "simple"
            },
            {
              "type": "int",
              "id": "steps",
              "link_to": {
                "node_id": "KSampler",
                "input": "steps"
              },
              "default": 30,
              "suffix": " steps"
            }
          ]
        },
        {
          "type": "float",
          "id": "prompt_weight",
          "link_to": {
            "node_id": "KSampler",
            "input": "cfg"
          },
          "suffix": " prompt weight",
          "default": 5.0
        },
        {
          "type": "prompt",
          "id": "default_prompt",
          "tooltip": "Default prompt",
          "placeholder": "Default prompt..."
        },
        {
          "type": "int",
          "id": "batch_size",
          "link_to": {
            "node_id": "krita_comfyui: img2img",
            "input": "batch_size"
          },
          "suffix": " batch size",
          "default": 4
        },
        {
          "type": "int",
          "id": "feather",
          "link_to": {
            "node_id": "krita_comfyui: KritaSelectionFeather",
            "input": "amount"
          },
          "suffix": "px feathering",
          "default": 16
        },
        {
          "type": "group",
          "id": "detail_group",
          "label": "Detailer",
          "indent": true,
          "children": [
            {
              "type": "row",
              "children": [
                {
                  "type": "boolean",
                  "id": "detail_enabled",
                  "tooltip": "Enable detailing when inpainting.",
                  "default": true
                },
                {
                  "type": "float",
                  "id": "detail_megapixels",
                  "stretch": 1,
                  "link_to": {
                    "node_id": "krita_comfyui: DetailSize",
                    "input": [
                      "resize_type",
                      "scale total pixels",
                      "megapixels"
                    ]
                  },
                  "enabled_if": {
                    "id": "detail_enabled",
                    "value": true
                  },
                  "suffix": " megapixels"
                }
              ]
            },
            {
              "type": "boolean",
              "id": "detail_always",
              "label": "Always detail",
              "tooltip": "If false then it will only detail when inpainting.",
              "default": false
            }
          ]
        },
        {
          "type": "group",
          "id": "debug_group",
          "label": "Debug",
          "indent": true,
          "children": [
            {
              "type": "boolean",
              "id": "debug_text",
              "label": "Debug text",
              "default": false
            },
            {
              "type": "boolean",
              "id": "debug_images",
              "label": "Debug images",
              "default": false
            }
          ]
        }
      ]
    }
  ],

